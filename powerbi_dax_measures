UniqueCustomers = DISTINCTCOUNT(Customers[CustomerID])

Avgsaleperorder  = AVERAGE(Orders[Sales])

TotalProductCost = SUMX(Orders,Orders[Quantity]*RELATED(Products[UnitPrice]))

Totalprofit  = VAR TOTALSALE = SUM(Orders[Sales])
VAR Totalproductcost = SUMX(Orders,Orders[Quantity] * RELATED(Products[UnitPrice]))
RETURN
TOTALSALE - Totalproductcost


SouthRegionsale  = CALCULATE([TotalSale],Customers[Region] = "South")

PercentageCountribution = DIVIDE(SUM(Orders[Sales]),CALCULATE(SUM(Orders[Sales]),ALL(Products[Category])))


Customersbytotalsales  =    RANKX(ALL(Orders[CustomerID]),[TotalSale],,DESC,Dense)

CoorperateCustomerSales  = CALCULATE([TotalSale],Customers[Segment] = "Corporate")

YTDSALES  = TOTALYTD([TotalSale],Orders[OrderDate])

PrevMonthSales  = CALCULATE([TotalSale],DATEADD('Date'[Date],-1,MONTH))

MOMGROWTH  = VAR CURENTMONTHSLES  = [TotalSale]
VAR PREVMONTHSALES  = CALCULATE([TotalSale],DATEADD('Date'[Date],-1,MONTH))
RETURN
DIVIDE(CURENTMONTHSLES-PREVMONTHSALES,PREVMONTHSALES)

